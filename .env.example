# --- Database ---
POSTGRES_USER=anvil
POSTGRES_PASSWORD=anvil
POSTGRES_DB=anvil
DATABASE_URL=postgresql+psycopg://anvil:anvil@postgres:5432/anvil

# --- Redis (worker queue) ---
REDIS_URL=redis://redis:6379/0

# --- Storage (default: MinIO for dev; swap to s3/azure/gcs/local in prod) ---
STORAGE_PROVIDER=minio
STORAGE_BUCKET=anvil
MINIO_ROOT_USER=anvil
MINIO_ROOT_PASSWORD=anvilanvil
MINIO_ENDPOINT=http://minio:9000

# --- Auth ---
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# Deployment env. When set to "production", Anvil refuses to start with
# default JWT_SECRET / default admin password.
ANVIL_ENV=development

# Bootstrap admin (defaults preserve existing dev/CI scripts). Set
# ANVIL_ADMIN_BOOTSTRAP=false to skip auto-creation. In production the
# default password is rejected.
ANVIL_ADMIN_BOOTSTRAP=true
ANVIL_ADMIN_EMAIL=admin@anvil.dev
ANVIL_ADMIN_PASSWORD=admin

# Set false to disable open signup (e.g. invite-only deployments).
ALLOW_SIGNUP=true

# OAuth (leave any client id/secret blank to disable that provider).
# Frontend strict redirect target; OAUTH_REDIRECT_BASE is the public URL of
# this API used to build provider redirect_uri values.
FRONTEND_URL=http://localhost:5173
OAUTH_REDIRECT_BASE=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- ML service ---
ML_SERVICE_URL=http://ml:8001
ANVIL_ML_INTERNAL_TOKEN=anvil-local-ml
SAM2_CHECKPOINT=/checkpoints/sam2.1_hiera_base_plus.pt
SAM2_MODEL_CFG=configs/sam2.1/sam2.1_hiera_b+.yaml
ML_DEVICE=auto  # auto|cuda|mps|cpu
# Optional personal-use ProPainter host worker (never shipped in Docker).
PERSONAL_VIDEO_WORKER_URL=auto
ANVIL_PERSONAL_WORKER_TOKEN=anvil-personal-worker

# --- SAM3 (optional; SAM2 works without any of this) ---
# SAM3 weights are gated on Hugging Face. Either run `hf auth login` on the host
# (the cache below is shared into the container), or set a token here.
HF_TOKEN=
# Host Hugging Face cache mounted into the ML container. Change if yours differs.
HF_CACHE_DIR=
SAM3_MODEL_ID=facebook/sam3
# Resident model memory budget in GB. SAM2 ~2.1 + SAM3 ~3.5 = ~5.6.
# Above this the least-recently-used model is released instead of risking an
# OOM kill. Raise it only if your Docker VM has the headroom.
ANVIL_MODEL_MEMORY_BUDGET_GB=6.0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Web ---
VITE_API_URL=http://localhost:8000
